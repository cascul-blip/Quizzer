{
  "name": "quizzer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --hot src/server/main.ts --data-dir ./dev-data --no-open --dev",
    "start": "bun src/server/main.ts",
    "mcp": "bun src/server/main.ts mcp",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "check": "biome ci . && tsc --noEmit && scripts/check-new-casts.sh && bun scripts/check-new-comments.ts && bun scripts/check-new-comments.ts --all && bun test",
    "audit:comments": "bun scripts/comment-inventory.ts",
    "build": "bun scripts/build.ts",
    "format": "biome check --write .",
    "prepare": "git config core.hooksPath .githooks"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "katex": "^0.19.1",
    "preact": "^10.29.8",
    "qrcode": "^1.5.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@babel/parser": "^8.1.3",
    "@biomejs/biome": "2.6.8",
    "@types/bun": "^1.4.2",
    "@types/katex": "^0.16.8",
    "@types/qrcode": "^1.5.6",
    "happy-dom": "^21.0.4",
    "typescript": "^7.0.2"
  }
}
