{
  "permissions": {
    "allow": [
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git checkout*)",
      "Bash(git switch*)",
      "Bash(git branch*)",
      "Bash(git pull*)",
      "Bash(git fetch*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git push*)",
      "Bash(gh issue list*)",
      "Bash(gh issue view*)",
      "Bash(gh pr list*)",
      "Bash(gh pr view*)",
      "Bash(gh pr create*)",
      "Bash(bun run check*)",
      "Bash(bun run typecheck*)",
      "Bash(bun test*)",
      "Bash(bun install*)"
    ]
  },
  "sandbox": {
    "excludedCommands": [
      "bun test*",
      "bun run check*"
    ]
  }
}
